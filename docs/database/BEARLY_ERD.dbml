  status varchar(20) [not null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table sorting_zones {
  id bigint [pk, increment, not null]
  sorting_center_id bigint [not null]
  code varchar(30) [not null]
  name varchar(120) [not null]
  destination_rules json
  status varchar(20) [not null]
  created_at timestamp
  updated_at timestamp
}

Table stores {
  id bigint [pk, increment, not null]
  seller_profile_id bigint [not null, unique]
  name varchar(160) [not null]
  slug varchar(180) [not null, unique]
  description text
  contact_email varchar(255)
  contact_phone varchar(30)
  logo_path varchar(500)
  banner_path varchar(500)
  publication_status varchar(30) [not null]
  published_at timestamp
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table support_tickets {
  id bigint [pk, increment, not null]
  ticket_no varchar(32) [not null, unique]
  user_id bigint
  name varchar(160)
  email varchar(255)
  role_label varchar(50)
  topic varchar(80) [not null]
  subject varchar(180) [not null]
  message text [not null]
  reference varchar(50)
  status varchar(30) [not null]
  priority varchar(20) [not null]
  assigned_to bigint
  created_at timestamp
  updated_at timestamp
}

Table system_settings {
  id bigint [pk, increment, not null]
  key varchar(100) [not null, unique]
  value json [not null]
  value_type varchar(20) [not null]
  is_public boolean [not null]
  updated_by bigint
  created_at timestamp
  updated_at timestamp
}

Table user_notification_preferences {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  event_key varchar(80) [not null]
  in_app boolean [not null]
  email boolean [not null]
  created_at timestamp
  updated_at timestamp
}

Table users {
  id bigint [pk, increment, not null]
  name varchar(255)
  first_name varchar(80) [not null]
  middle_initial varchar(5)
  middle_name varchar(80)
  last_name varchar(80) [not null]
  sex varchar(30)
  birthday date
  birth_date date
  email varchar(255) [not null, unique]
  phone varchar(30)
  contact_number varchar(30)
  role varchar(32)
  province varchar(120)
  city varchar(120)
  barangay varchar(120)
  street_address varchar(255)
  business_name varchar(160)
  business_category varchar(120)
  vehicle_type varchar(80)
  plate_number varchar(30)
  valid_id_path varchar(500)
  business_permit_path varchar(500)
  or_cr_path varchar(500)
  driver_license_path varchar(500)
  logistics_id bigint
  approved_by bigint
  approved_at timestamp
  rejection_reason text
  password varchar(255) [not null]
  status varchar(32) [not null]
  email_verified_at timestamp
  last_login_at timestamp
  suspended_at timestamp
  deactivated_at timestamp
  banned_at timestamp
  status_reason text
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table violation_actions {
  id bigint [pk, increment, not null]
  violation_id bigint [not null]
  action_type varchar(40) [not null]
  from_status varchar(30)
  to_status varchar(30)
  actor_user_id bigint
  reason text
  metadata json
  created_at timestamp [not null]
}

Table waybills {
  id bigint [pk, increment, not null]
  shipment_id bigint [not null, unique]
  waybill_no varchar(40) [not null, unique]
  scan_token char(64) [not null, unique]
  barcode_value varchar(120) [not null, unique]
  piece_count smallint [not null]
  total_weight_kg decimal(10,3) [not null]
  length_cm decimal(10,2)
  width_cm decimal(10,2)
  height_cm decimal(10,2)
  status varchar(30) [not null]
  generated_by bigint
  generated_at timestamp [not null]
  printed_at timestamp
  print_count smallint [not null]
  voided_at timestamp
  void_reason text
  created_at timestamp
  updated_at timestamp
}

Table wishlists {
  id bigint [pk, increment, not null]
  user_id bigint
  session_token varchar(100)
  product_id bigint [not null]
  created_at timestamp [not null]
}

