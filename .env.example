APP_NAME=Bearly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Front-end stage only
# No MySQL database connection is currently required.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local-bearly
REVERB_APP_KEY=local-bearly-key
REVERB_APP_SECRET=local-bearly-secret

# Internal listener Reverb binds to. 0.0.0.0:8080 lets Cloudflare Tunnel reach it.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public hostname presented to browsers / used for TLS certificate lookup.
REVERB_HOST=ws.bearlymarket.com
REVERB_PORT=443
REVERB_SCHEME=https

# Laravel's server-to-Reverb broadcaster. Always the internal listener; never
# the public hostname and never 0.0.0.0 as a destination.
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_BROADCAST_TIMEOUT=3
REVERB_BROADCAST_CONNECT_TIMEOUT=1

FILESYSTEM_DISK=local

QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bearly.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser-facing Reverb connection. Keep these explicit and public; never
# derive them from REVERB_BROADCAST_HOST, which is internal-only.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.bearlymarket.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Required for the MapTiler URL below. Put the real key in your local .env file.
# Restrict allowed HTTP origins in MapTiler Cloud for your dev and production domains.
MAPTILER_API_KEY=
MAPS_TILE_URL="https://api.maptiler.com/maps/streets-v4/{z}/{x}/{y}.png?key=${MAPTILER_API_KEY}"
MAPS_TILE_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_REGISTRATION_TTL=600

# Optional database seeding credentials.
# Keep SEED_ADMIN_PASSWORD blank in committed files.
SEED_ADMIN_EMAIL=admin@bearly.test
SEED_ADMIN_PASSWORD=
